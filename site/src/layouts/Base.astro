---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Optional per-page chrome theme, e.g. "constructivist". Undefined = none. */
  theme?: string;
}
const { title, description = 'A weekly column on the fictional ballet world.', theme } = Astro.props;
// BASE_URL may or may not carry a trailing slash depending on config; strip it
// and always join paths with a leading slash so URLs never collapse.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tagline = "A weekly notice from the ballet of a city that isn't there.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="R. A. Pi"
      href={`${base}/rss.xml`}
    />
    {theme && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        {/* Oswald carries a Cyrillic subset; used for display chrome only. */}
        <link
          rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;700&display=swap&subset=cyrillic,latin"
        />
      </>
    )}
  </head>
  <body data-theme={theme}>
    <div class="wrap">
      <header class="masthead">
        <a href={`${base}/`} class="site-brand">
          {/* Logo shows on the main (un-themed) pages only; the themed dispatch
              masthead carries the wordmark without it. */}
          {!theme && (
            <img
              src={`${base}/img/logo.jpg`}
              alt="R. A. Pi"
              width="72"
              height="72"
            />
          )}
          <span class="site-title">R. A. Pi</span>
        </a>
        {/* Un-themed pages keep the tagline inside the masthead. On a themed
            page the masthead is a busy striped band, so the tagline drops below
            it onto plain paper where it stays legible. */}
        {!theme && <p class="tagline">{tagline}</p>}
      </header>
      {theme && <p class="tagline tagline-standalone">{tagline}</p>}
      <main>
        <slot />
      </main>
      <footer>
        <p>
          R. A. Pi · canon-driven static column ·
          <a href={`${base}/rss.xml`}>RSS</a>
        </p>
      </footer>
    </div>

    <style>
      /* Pull the masthead up and hard to the left so the logo hugs the corner
         of the column. Negative offsets cancel most of .wrap's top/left inset;
         the column itself stays centered + minimalist. */
      .masthead {
        margin-top: -0.75rem;
        margin-left: -1.25rem;
        padding-left: 1.25rem;
      }
      /* Masthead brand: logo on the left, title inline + vertically centered. */
      .site-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        text-decoration: none;
      }
      .site-brand img {
        display: block;
        width: 72px;
        height: 72px;
        border-radius: 4px;
        object-fit: cover;
      }
      .site-title {
        font-size: 2.4rem;
        letter-spacing: 0.02em;
        font-weight: bold;
        line-height: 1;
      }
    </style>
  </body>
</html>
